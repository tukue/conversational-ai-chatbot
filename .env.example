GRADIO_SHARE=false
GRADIO_DEBUG=false
CHATBOT_DEVICE=cpu
ENABLE_GENERATIVE_FALLBACK=false
ENABLE_RAG=true
ENABLE_RATE_LIMITING=true

# Optional chatbot generation through the separately deployed policy proxy
USE_LLM_PROXY=false
PROXY_BASE_URL=http://127.0.0.1:8080
PROXY_CLIENT_KEY=
PROXY_MODEL=
PROXY_TIMEOUT=60
